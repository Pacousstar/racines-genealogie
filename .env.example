# =====================================================================
# GÉNÉALOGIE TOA-ZÉO — variables d'environnement
# Copier ce fichier vers .env.local et remplir les vraies valeurs.
# .env.local est IGNORÉ par git — ne jamais committer les vraies clés.
# =====================================================================

# URL du projet Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique « anon » — utilisable côté navigateur (protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé « service role » — UNIQUEMENT côté serveur (jamais dans le navigateur !)
# Utilisée pour créer les comptes utilisateurs (API admin) et servir les photos.
SUPABASE_SERVICE_ROLE_KEY=
